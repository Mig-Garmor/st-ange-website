{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/cron/chat-insights", "schedule": "0 10 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
